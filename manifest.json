{
  "manifest_version": 3,
  "name": "Do It Later — Web Clipper & Thought Capture",
  "version": "1.1.0",
  "key": "",
  "description": "Highlight web articles, notes, and research, and dispatch them directly to your Do It Later mobile vault.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Do It Later Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://doitlater-api-proxy.kanasingh974.workers.dev/*"
  ]
}
